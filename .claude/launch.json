{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aether-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd aether-backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000"],
      "port": 8000
    },
    {
      "name": "aether-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "aether-frontend", "run", "dev"],
      "port": 3001
    },
    {
      "name": "allure-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Allure-Landing-Page", "run", "dev"],
      "port": 3000
    }
  ]
}
