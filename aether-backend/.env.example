# ============================================================
# AETHER WALKTHROUGH BACKEND — .env.example
# Copy to .env and fill in real values. NEVER commit .env.
# The backend runs fully WITHOUT any keys — providers fall
# back to deterministic mock mode until keys are added.
# ============================================================

# ── Application ─────────────────────────────────────────────
AETHER_HOST=127.0.0.1
AETHER_PORT=8000
# Comma-separated origins allowed to call this API (the Next.js frontend)
AETHER_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Storage ─────────────────────────────────────────────────
# Where scenes / projects / history are persisted (JSON files)
AETHER_DATA_DIR=./data

# ── AI Providers (all optional) ─────────────────────────────
# Which LLM drives the intelligence layer: auto | anthropic | gemini | mock
# auto = Claude when ANTHROPIC_API_KEY is set, else Gemini when GEMINI_API_KEY is set, else mock.
INTELLIGENCE_PROVIDER=auto

# Claude (Anthropic) — vision analysis with structured outputs. Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_SECONDS=90

# Gemini — design intelligence. Get a key: https://aistudio.google.com/app/apikey
# Google retires model ids often; the fallback list is tried on 404/429/503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest,gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60

# Meshy — 3D asset generation fallback. Get a key: https://www.meshy.ai
MESHY_API_KEY=
MESHY_BASE_URL=https://api.meshy.ai
MESHY_TIMEOUT_SECONDS=300

# When true (default), missing/failing providers fall back to
# deterministic mock behaviour instead of erroring.
PROVIDER_FALLBACK_TO_MOCK=true

# ── Blender (hybrid local pipeline) ─────────────────────────
# Portable Blender 5.2 LTS executable. Empty = render jobs fail fast.
BLENDER_PATH=
BLENDER_TIMEOUT_SECONDS=1800

# ── Job runner ──────────────────────────────────────────────
JOBS_AI_WORKERS=2
JOBS_RENDER_WORKERS=1
JOBS_RETRY_DELAY_SECONDS=2
